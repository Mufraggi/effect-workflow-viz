# Copy to `.env` (or inject these into the container environment) and fill in.
# Validated at boot by packages/web/app/env-check.ts — a missing required
# variable aborts startup with a clear message.

# --- Workflow Postgres (read-only) — all required ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PWD=postgres
DB_NAME=cluster
# "production" enables SSL to Postgres (also auto-enabled for *.azure.com hosts).
ENV=development

# --- Session cookie ---
# REQUIRED in production (NODE_ENV=production). Generate with: openssl rand -hex 32
# In development a fixed insecure secret is used if this is unset.
SESSION_SECRET=

# --- Optional ---
# HTTP port (default 3000).
# PORT=3000
# Auth SQLite file (default ./data/auth.db; the Docker image sets /app/data/auth.db).
# AUTH_DB_PATH=./data/auth.db
