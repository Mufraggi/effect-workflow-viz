{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "references": [
    { "path": "../domain" },
    { "path": "../api-contract" }
  ],
  "compilerOptions": {
    "types": [],
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*.js"],
      "@template/domain": ["../domain/src/index.js"],
      "@template/domain/*": ["../domain/src/*.js"],
      "@template/api-contract": ["../api-contract/src/index.js"],
      "@template/api-contract/*": ["../api-contract/src/*.js"]
    }
  }
}
