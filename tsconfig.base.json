{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "moduleDetection": "force",
    "composite": true,
    "downlevelIteration": true,
    "resolveJsonModule": true,
    "esModuleInterop": false,
    "declaration": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "isolatedModules": true,
    "sourceMap": true,
    "declarationMap": true,
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": false,
    "noErrorTruncation": false,
    "allowJs": false,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": false,
    "strictNullChecks": true,
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "incremental": true,
    "removeComments": false,
    "jsx": "react-jsx",
    "plugins": [{ "name": "@effect/language-service" }],
    "paths": {
      "@template/domain": ["./packages/domain/src/index.js"],
      "@template/domain/*": ["./packages/domain/src/*.js"],
      "@template/domain/test/*": ["./packages/domain/test/*.js"],
      "@template/database": ["./packages/database/src/index.js"],
      "@template/database/*": ["./packages/database/src/*.js"],
      "@template/database/test/*": ["./packages/database/test/*.js"],
      "@template/auth": ["./packages/auth/src/index.js"],
      "@template/auth/*": ["./packages/auth/src/*.js"],
      "@template/auth/test/*": ["./packages/auth/test/*.js"],
      "@template/api": ["./packages/api/src/index.js"],
      "@template/api/*": ["./packages/api/src/*.js"],
      "@template/api/test/*": ["./packages/api/test/*.js"],
      "@template/environments": ["./packages/environments/src/index.js"],
      "@template/environments/*": ["./packages/environments/src/*.js"],
      "@template/environments/test/*": ["./packages/environments/test/*.js"],
      "@template/mcp": ["./packages/mcp/src/index.js"],
      "@template/mcp/*": ["./packages/mcp/src/*.js"]
    }
  }
}
